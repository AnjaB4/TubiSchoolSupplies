//MY OLD new login that messed everything up from Admincontroller. didint even need it i had adminLogin in authcontroller
    public function login() {
        session_start();

        // If already logged in, redirect to admin dashboard
        if (isset($_SESSION['is_admin']) && $_SESSION['is_admin'] === true) {
            header("Location: /admin");
            exit;
        }

        $error = '';

        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $username = $_POST['username'] ?? '';
            $password = $_POST['password'] ?? '';

            require_once '../config/db.php'; // ensure $conn is available

            // Query DB for admin user
            $stmt = $conn->prepare("SELECT * FROM admin WHERE username = ?");
            $stmt->bind_param("s", $username);
            $stmt->execute();
            $result = $stmt->get_result();

            if ($admin = $result->fetch_assoc()) {
                // Verify hashed password
                if (password_verify($password, $admin['password'])) {
                    $_SESSION['is_admin'] = true;
                    $_SESSION['admin_id'] = $admin['id_admin'];
                    header("Location: /admin");
                    exit;
                } else {
                    $error = "Pogrešno korisničko ime ili lozinka.";
                }
            } else {
                $error = "Pogrešno korisničko ime ili lozinka.";
            }
        }

        // Show login form
        require_once '../app/views/admin_login.php';
    }


