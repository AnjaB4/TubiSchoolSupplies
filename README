//STARI receipt.php
<?php
//GENERATE ORDER NUMBER LOGIC
include_once '../config/db.php';

// Get current year in two-digit format
$year = date('y');

// Prepare and run query to get the latest receipt for this year
$query = "SELECT receipt_number FROM receipt 
          WHERE RIGHT(receipt_number, 2) = ? 
          ORDER BY id_receipt DESC 
          LIMIT 1";
$stmt = $conn->prepare($query);
$stmt->bind_param("s", $year);
$stmt->execute();
$result = $stmt->get_result();

// Determine the next number
if ($row = $result->fetch_assoc()) {
    // Extract number and increment
    list($lastNumber, $yr) = explode('/', $row['receipt_number']);
    $nextNumber = (int)$lastNumber + 1;
} else {
    // No receipt yet for this year
    $nextNumber = 1;
}

// Combine into final receipt number
$receiptNumber = $nextNumber . '/' . $year;

echo "Generated receipt number: " . $receiptNumber;

// Example of inserting into database
/*
$insert = $conn->prepare("INSERT INTO receipt (id_user, id_product, receipt_number, date_created) VALUES (?, ?, ?, CURDATE())");
$insert->bind_param("iis", $id_user, $id_product, $receiptNumber);
$insert->execute();
*/

$stmt->close();
$conn->close();

?>


