    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/scripts.js"></script>
    <script>
        $(document).ready(function() {
            // Enable/disable quantity input
            $(document).on('change', '.product-checkbox', function () {
                const quantityInput = $(this).closest('.product-row').find('.quantity-input');
                quantityInput.prop('disabled', !this.checked);
                if (!this.checked) quantityInput.val('');
                calculateTotal();
            });

            $(document).on('input', '.quantity-input', function () {
                calculateTotal();
            });

            function calculateTotal() {
                let total = 0;
                $('.product-row').each(function () {
                    const checkbox = $(this).find('.product-checkbox');
                    const quantityInput = $(this).find('.quantity-input');
                    if (checkbox.is(':checked') && quantityInput.val()) {
                        const priceText = checkbox.parent().text().match(/(\d+,\d+|\d+\.\d+)/);
                        const unitPrice = parseFloat(priceText[0].replace(',', '.'));
                        const quantity = parseFloat(quantityInput.val());
                        if (!isNaN(unitPrice) && !isNaN(quantity)) {
                            total += unitPrice * quantity;
                        }
                    }
                });
                $('#total-price').text(total.toFixed(2));
            }

            // Product search
            $('#product-search').on('input', function () {
                const term = $(this).val().toLowerCase();
                $('.product-row').each(function () {
                    const rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(term));
                });
            });
        });
    </script>
</body>
</html>


//OLD receipt historypage method
public function receiptsPage($page = 1) {
        require_once '../config/db.php';

        $perPage = 20;
        $page = max((int)$page, 1);
        $offset = ($page - 1) * $perPage;

        // You can add filtering here if you want to support month/year filters via GET

        $stmt = $conn->prepare("
            SELECT r.*, u.school_name
            FROM receipt r
            JOIN user u ON r.id_user = u.id_user
            ORDER BY r.date_created DESC
            LIMIT ? OFFSET ?
        ");
        $stmt->bind_param("ii", $perPage, $offset);
        $stmt->execute();
        $result = $stmt->get_result();
        $receipts = $result->fetch_all(MYSQLI_ASSOC);
        $stmt->close();

        require '../app/views/partials/receipt_rows.php';
    }


//  MY OLD RECEIPT SUBMISSION
 public function submitReceipt() {
        require_once '../config/db.php';

        // Check if form submitted with products and user ID
        if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['id_user']) && !empty($_POST['products'])) {
            $id_user = intval($_POST['id_user']);
            $products = $_POST['products']; // array with productId => ['selected'=>..., 'quantity'=>...]

            // Validate products and quantities
            $validProducts = [];
            foreach ($products as $id_product => $data) {
                if (isset($data['selected']) && !empty($data['quantity']) && is_numeric($data['quantity']) && intval($data['quantity']) > 0) {
                    $validProducts[intval($id_product)] = intval($data['quantity']);
                }
            }

            if (empty($validProducts)) {
                echo "No valid products selected.";
                return;
            }

            // Insert new receipt
            $stmt = $conn->prepare("INSERT INTO receipt (id_user, date_created) VALUES (?, NOW())");
            $stmt->bind_param("i", $id_user);

            if ($stmt->execute()) {
                $id_receipt = $stmt->insert_id;

                // Insert receipt_product rows
                $stmt->close();

                $stmtProd = $conn->prepare("INSERT INTO receipt_product (id_receipt, id_product, quantity) VALUES (?, ?, ?)");

                foreach ($validProducts as $productId => $quantity) {
                    $stmtProd->bind_param("iii", $id_receipt, $productId, $quantity);
                    $stmtProd->execute();
                }

                $stmtProd->close();
                // redirect to 
                header("Location: /admin/viewReceipt/$id_receipt");
                exit;
            } else {
                echo "Failed to create receipt.";
            }
        } else {
            echo "Invalid request.";
        }
    }




